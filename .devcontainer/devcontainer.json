{
  "name": "Smart Diabetes Health Platform",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "root",
  "workspaceFolder": "/workspaces/smart-diabetes-health-platform",
  "forwardPorts": [
    5000,
    5001,
    8080,
    1433
  ],
  "portsAttributes": {
    "1433": {
      "label": "SQL Server",
      "protocol": "tcp",
      "onAutoForward": "silent"
    },
    "5000": {
      "label": "ASP.NET Core API",
      "protocol": "http",
      "onAutoForward": "notify"
    },
    "5001": {
      "label": "ASP.NET Core HTTPS",
      "protocol": "https",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Flutter Web",
      "protocol": "http"
    }
  },
  "containerEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development",
    "ASPNETCORE_URLS": "http://0.0.0.0:5000"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code",
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter",
        "dotnet.defaultSolution": "DiabetesPlatform.sln"
      }
    }
  },
  "postCreateCommand": "dotnet restore DiabetesPlatform.sln && cd mobile && flutter pub get",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "postStartCommand": "bash ./scripts/start-codespaces-sqlserver.sh",
  "waitFor": "postStartCommand"
}
